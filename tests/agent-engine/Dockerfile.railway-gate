# Integration-test appliance ONLY: never route business A2A/agent requests here.
# Build context is the Agent-Factory repo root; Railway dockerfilePath points here.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANGGRAPH_STRICT_MSGPACK=true \
    PYTHONPATH=/workspace/services/agent-builder:/workspace/services/agent-runtime:/workspace/services/litellm-adapter
ENV HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends nodejs postgresql postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY services/agent-builder/ services/agent-builder/
COPY services/agent-runtime/ services/agent-runtime/
COPY services/litellm-adapter/ services/litellm-adapter/
COPY tests/agent-engine/ tests/agent-engine/
RUN python -m pip install --no-cache-dir -r tests/agent-engine/requirements-integration.txt \
    && chown -R postgres:postgres /workspace
USER postgres
EXPOSE 8080
CMD ["bash", "tests/agent-engine/railway_gate_entrypoint.sh"]
