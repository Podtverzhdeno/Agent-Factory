{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@studio/contracts": [
        "./src/contracts/index.ts"
      ],
      "@studio/api": [
        "./src/platform-ports/api.ts"
      ],
      "@studio/ui": [
        "./src/platform-ports/ui.tsx"
      ],
      "@studio/charts": [
        "./src/platform-ports/charts.tsx"
      ],
      "@studio/auth": [
        "./src/platform-ports/auth.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
